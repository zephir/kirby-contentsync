{
    "name": "zephir/kirby-contentsync",
    "description": "Kirby contentsync plugin",
    "license": "MIT",
    "type": "kirby-plugin",
    "version": "3.0.0",
    "authors": [
        {
            "name": "Marc Stampfli",
            "email": "marc@zephir.ch"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cli": "^2.0",
        "getkirby/cms": "^4.0 || ^5.0 || ^6.0"
    },
    "suggest": {
        "getkirby/cli": "Runs the content:sync command. Install it globally or in your project."
    },
    "autoload": {
        "psr-4": {
            "Zephir\\Contentsync\\": "src/"
        }
    },
    "extra": {
        "kirby": {
            "compatible": "^4.0 || ^5.0 || ^6.0"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    }
}
